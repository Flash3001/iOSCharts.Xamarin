<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>iOSCharts</RootNamespace>
    <AssemblyName>iOSCharts</AssemblyName>
    <IsBindingProject>true</IsBindingProject>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- Xcode 26.6 / iOS 26.5 SDK; DGCharts itself is built with IPHONEOS_DEPLOYMENT_TARGET 12.0 -->
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <!-- .NET default (true): the xcframework ships as the iOSCharts.resources binding resource package next to the dll -->
    <NoBindingEmbedding>true</NoBindingEmbedding>
    <!-- replaces the old [assembly: LinkerSafe] -->
    <IsTrimmable>true</IsTrimmable>
    <!-- CS0108/CS0114: classes adopt protocols in the bare form (interface Foo : FooProtocol), which is what
         makes bgen inline the members and implement IFooProtocol; the same members get inlined again in every
         subclass and hide the base ones. Harmless: same selectors. -->
    <NoWarn>$(NoWarn);CS0108;CS0114</NoWarn>

    <PackageId>iOSCharts</PackageId>
    <Title>iOSCharts</Title>
    <Description>A .NET for iOS binding by Lucas Teixeira for Charts (DGCharts) by Daniel Cohen Gindi, inspired by Philipp Jahoda.</Description>
    <PackageReleaseNotes>Charts (DGCharts) 5.1.0 as an xcframework (device arm64, simulator arm64 + x86_64). .NET 10 / Xcode 26.6. Breaking changes: https://github.com/ChartsOrg/Charts/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Version>5.1.0</Version>
    <Authors>Flash3001</Authors>
    <Company></Company>
    <Copyright>Copyright 2016-2026 Lucas Teixeira</Copyright>
    <PackageProjectUrl>https://github.com/Flash3001/iOSCharts.Xamarin</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Xamarin;iOS;dotnet-ios;Charts;DGCharts;iOSCharts;MPAndroidCharts-inspired;LineChart;Combined-Chart;BarChart;Horizontal-BarChart;PieChart;ScatterChart;CandleStickChart;BubbleChart;RadarChart</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="Structs.cs" />
    <!-- NUGET.md is the consumer-facing readme shown on nuget.org; README.md is for maintainers -->
    <None Include="NUGET.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="DGCharts.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
      <Frameworks>Foundation CoreGraphics QuartzCore UIKit</Frameworks>
    </NativeReference>
  </ItemGroup>
</Project>
